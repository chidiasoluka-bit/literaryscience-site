<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Engage &mdash; Literary Science</title>
<link rel="stylesheet" href="/css/style.css">
<style>
  .page-header {
    padding: 8rem 3rem 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1; letter-spacing: -0.02em;
    margin-bottom: 0.8rem;
  }
  .page-header .page-desc {
    font-family: 'EB Garamond', serif;
    font-size: 1.15rem; line-height: 1.75;
    color: var(--warm-gray); max-width: 500px;
  }

  .offerings {
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--paper-dark);
  }

  .offering {
    display: grid;
    grid-template-columns: 300px 1fr;
    border-bottom: 1px solid var(--paper-dark);
    transition: background 0.4s;
  }

  .offering:hover { background: var(--paper-light); }

  .offering-left {
    padding: 3rem;
    border-right: 1px solid var(--paper-dark);
  }

  .offering-num {
    font-family: 'Libre Baskerville', serif;
    font-size: 3rem; font-weight: 700;
    opacity: 0.05; line-height: 1;
    margin-bottom: 1rem;
  }

  .offering-title {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.25;
  }

  .offering-tag {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.45rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faded);
    margin-top: 0.5rem;
  }

  .offering-right {
    padding: 3rem;
  }

  .offering-body {
    font-family: 'EB Garamond', serif;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--warm-gray);
    max-width: 520px;
  }

  .offering-body + .offering-body { margin-top: 1rem; }

  .offering-formats {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .format-tag {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.45rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--paper-dark);
    color: var(--faded);
  }

  .offering-cta {
    margin-top: 2rem;
  }

  .offering-cta a {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.52rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding: 0.6rem 1.4rem;
    border: 1px solid var(--ink);
    transition: all 0.3s;
    display: inline-block;
  }

  .offering-cta a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* contact strip */
  .contact-strip {
    padding: 4rem 3rem;
    background: var(--ink);
    color: var(--paper);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .contact-strip::before, .contact-strip::after {
    content: ''; position: absolute;
    top: 0; bottom: 0; width: 20px;
    background: repeating-linear-gradient(to bottom,
      transparent 0px, transparent 3px,
      rgba(242,242,242,0.03) 3px, rgba(242,242,242,0.03) 4px);
  }
  .contact-strip::before { left: 0; }
  .contact-strip::after { right: 0; }

  .contact-strip h2 {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .contact-strip p {
    font-family: 'EB Garamond', serif;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--paper-dark);
    max-width: 480px;
    margin: 0 auto;
  }

  .contact-strip a {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    border: 1px solid var(--paper-dark);
    padding: 0.7rem 1.6rem;
    display: inline-block;
    margin-top: 2rem;
    transition: all 0.3s;
  }

  .contact-strip a:hover {
    background: var(--paper);
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .offering { grid-template-columns: 1fr; }
    .offering-left { border-right: none; border-bottom: 1px solid var(--paper-dark); padding: 2rem 1.5rem; }
    .offering-right { padding: 2rem 1.5rem; }
  }
</style>
</head>
<body>

