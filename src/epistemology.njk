<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Epistemology of Literary Science</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,700&family=JetBrains+Mono:wght@300;400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');

  :root {
    --ink: #111111;
    --paper: #f2f2f2;
    --paper-dark: #d5d5d5;
    --paper-light: #fafafa;
    --faded: #888888;
    --warm-gray: #555555;
    --accent: #1a1a1a;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { font-size: 17px; scroll-behavior: smooth; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'EB Garamond', serif;
    overflow-x: hidden;
    position: relative;
  }

  /* ── FILM GRAIN OVERLAY ── */
  body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    animation: grainShift 0.5s steps(4) infinite;
  }

  /* subtle grain animation */
  @keyframes grainShift {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-2px, 1px); }
    50% { transform: translate(1px, -1px); }
    75% { transform: translate(-1px, 2px); }
    100% { transform: translate(0, 0); }
  }

  /* vignette */
  body::after {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 9998;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(17,17,17,0.1) 100%);
  }

  ::selection {
    background: var(--ink);
    color: var(--paper);
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.2rem 3rem;
    background: var(--paper);
    border-bottom: 1px solid var(--paper-dark);
  }

  .nav-logo {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-links {
    display: flex;
    gap: 2.2rem;
    list-style: none;
  }

  .nav-links a {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--faded);
    transition: color 0.4s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--ink);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 8rem 3rem 5rem;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .hero-issue {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--faded);
    margin-bottom: 3rem;
    opacity: 0;
    animation: fadeIn 1.5s ease 0.3s forwards;
  }

  .hero-title {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 750px;
    opacity: 0;
    animation: revealSlow 1.5s cubic-bezier(0.25, 0.1, 0.25, 1) 0.1s forwards;
  }

  .hero-epigraph {
    font-family: 'EB Garamond', serif;
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.75;
    max-width: 520px;
    margin-top: 2.5rem;
    color: var(--warm-gray);
    opacity: 0;
    animation: fadeIn 1.5s ease 0.8s forwards;
  }

  .hero-rule {
    width: 50px;
    height: 1px;
    background: var(--faded);
    margin-top: 3rem;
    opacity: 0;
    animation: expandLine 1.2s ease 1.2s forwards;
  }

  .hero-byline {
    display: flex;
    gap: 2.5rem;
    margin-top: 1.5rem;
    opacity: 0;
    animation: fadeIn 1.5s ease 1.5s forwards;
  }

  .hero-byline span {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--faded);
  }

  /* ── EPIGRAPH STRIP ── */
  .epigraph-strip {
    padding: 2.5rem 3rem;
    border-top: 1px solid var(--paper-dark);
    border-bottom: 1px solid var(--paper-dark);
    text-align: center;
    background: var(--paper-light);
  }

  .epigraph-strip p {
    font-family: 'EB Garamond', serif;
    font-size: 1rem;
    font-style: italic;
    letter-spacing: 0.03em;
    color: var(--warm-gray);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .epigraph-strip .attr {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.5rem;
    font-style: normal;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faded);
    margin-top: 0.8rem;
    display: block;
  }

  /* ── ARTICLE ── */
  .article {
    max-width: 620px;
    margin: 0 auto;
    padding: 4rem 3rem 8rem;
  }

  .article-section {
    margin-top: 4.5rem;
  }

  .article-section:first-child {
    margin-top: 2rem;
  }

  /* Section headers - like chapter titles in a printed book */
  .section-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--paper-dark);
  }

  .section-num {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.5rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--faded);
    display: block;
    margin-bottom: 0.6rem;
  }

  .section-title {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  /* Body paragraphs */
  .article p {
    font-family: 'EB Garamond', serif;
    font-size: 1.12rem;
    line-height: 1.9;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 1.4rem;
    text-indent: 0;
  }

  .article p + p {
    text-indent: 1.5em;
  }

  .article p.no-indent {
    text-indent: 0;
  }

  .article p em {
    font-style: italic;
  }

  .article p strong {
    font-weight: 700;
  }

  /* Drop cap on first section */
  .drop-cap::first-letter {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 4.2rem;
    float: left;
    line-height: 0.75;
    margin-right: 0.12em;
    margin-top: 0.1em;
    color: var(--ink);
  }

  /* ── PULL QUOTES ── */
  .pull-quote {
    margin: 3rem -2rem;
    padding: 2rem 2rem;
    position: relative;
  }

  .pull-quote::before {
    content: '\201C';
    font-family: 'Libre Baskerville', serif;
    font-size: 6rem;
    color: var(--paper-dark);
    position: absolute;
    top: -0.5rem;
    left: 0.5rem;
    line-height: 1;
  }

  .pull-quote p {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.65;
    color: var(--accent);
    margin-bottom: 0;
    text-indent: 0 !important;
    padding-left: 0.5rem;
    border-left: 2px solid var(--paper-dark);
  }

  /* ── FULL-WIDTH BREAK (the slaughterhouse moment) ── */
  .full-break {
    margin: 4rem calc(-50vw + 50%);
    padding: 5rem 3rem;
    background: var(--ink);
    color: var(--paper);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* scratchy film edge effect */
  .full-break::before,
  .full-break::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 30px;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 3px,
      rgba(242,242,242,0.04) 3px,
      rgba(242,242,242,0.04) 4px
    );
  }
  .full-break::before { left: 0; }
  .full-break::after { right: 0; }

  .full-break .break-text {
    font-family: 'Libre Baskerville', serif;
    font-size: clamp(1.3rem, 2.8vw, 1.9rem);
    font-style: italic;
    line-height: 1.65;
    max-width: 650px;
    margin: 0 auto;
    font-weight: 400;
    color: var(--paper);
  }

  .full-break .break-attr {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.5rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-top: 2rem;
    color: var(--faded);
