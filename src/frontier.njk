  /* axis labels */
  .axis-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: #666;
  }

  .axis-label-large {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 11px;
    fill: #999;
  }

  /* frontier curve */
  .frontier-curve {
    fill: none;
    stroke: #f2f2f2;
    stroke-width: 2;
    stroke-dasharray: 800;
    stroke-dashoffset: 800;
    transition: stroke-dashoffset 2.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .frontier-curve.drawn {
    stroke-dashoffset: 0;
  }

  /* zone fills */
  .zone-fill {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .zone-fill.visible { opacity: 1; }

  /* strategy markers */
  .strategy-dot {
    fill: #f2f2f2;
    r: 0;
    transition: r 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .strategy-dot.visible { r: 6; }

  .strategy-dot-ring {
    fill: none;
    stroke: #f2f2f2;
    stroke-width: 1;
    r: 0;
    opacity: 0.3;
    transition: r 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s;
  }
  .strategy-dot-ring.visible { r: 14; }

  .strategy-label {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 13px;
    fill: #f2f2f2;
    opacity: 0;
    transition: opacity 0.8s ease 0.3s;
  }
  .strategy-label.visible { opacity: 1; }

  .strategy-sublabel {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 7.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: #888;
    opacity: 0;
    transition: opacity 0.8s ease 0.45s;
  }
  .strategy-sublabel.visible { opacity: 1; }

  /* frontier label */
  .frontier-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 8px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    fill: #666;
    opacity: 0;
    transition: opacity 1s ease 2s;
