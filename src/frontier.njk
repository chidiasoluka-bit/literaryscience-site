<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Literary Productivity Frontier &mdash; Literary Science</title>
<link rel="stylesheet" href="/css/style.css">
<style>
  .page-header {
    padding: 8rem 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .page-header .doc-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.45rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--faded);
    margin-bottom: 1.5rem;
  }
  .page-header h1 {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 700px;
  }
  .page-header .page-desc {
    font-family: 'EB Garamond', serif;
    font-size: 1.15rem; line-height: 1.75;
    color: var(--warm-gray); max-width: 560px;
    margin-top: 1.2rem;
  }

  /* ── FRONTIER DIAGRAM ── */
  .frontier-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 3rem 0;
  }

  .frontier-diagram {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--ink);
    border: 2px solid var(--ink);
    overflow: hidden;
  }

  .frontier-diagram svg {
    width: 100%;
    height: 100%;
  }

  /* axis labels */
  .axis-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: #666;
  }

  .axis-label-large {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 11px;
    fill: #999;
  }

  /* frontier curve */
  .frontier-curve {
    fill: none;
    stroke: #f2f2f2;
    stroke-width: 2;
    stroke-dasharray: 800;
    stroke-dashoffset: 800;
    transition: stroke-dashoffset 2.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .frontier-curve.drawn {
    stroke-dashoffset: 0;
  }

  /* zone fills */
  .zone-fill {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .zone-fill.visible { opacity: 1; }

  /* strategy labels */
  .strategy-label {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 13px;
    fill: #f2f2f2;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .strategy-label.visible { opacity: 1; }

  .strategy-sublabel {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 7.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: #888;
    opacity: 0;
    transition: opacity 0.8s ease 0.15s;
  }
  .strategy-sublabel.visible { opacity: 1; }

  /* frontier label */
  .frontier-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    fill: rgba(242,242,242,0.35);
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .frontier-label.visible { opacity: 1; }

  /* direction arrows */
  .dir-arrow {
    transition: opacity 0.8s ease;
  }

  /* ── STRATEGY CARDS ── */
  .strategies {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-top: 2px solid var(--ink);
  }

  .strategy-card {
    padding: 2.5rem 2.5rem 3rem;
    border-right: 1px solid var(--paper-dark);
    transition: all 0.4s;
    cursor: default;
  }

  .strategy-card:last-child { border-right: none; }

  .strategy-card:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .strategy-card:hover .sc-num,
  .strategy-card:hover .sc-question { color: var(--faded); }
  .strategy-card:hover .sc-desc { color: rgba(242,242,242,0.7); }
  .strategy-card:hover .sc-example { color: rgba(242,242,242,0.6); border-color: rgba(242,242,242,0.15); }
  .strategy-card:hover .sc-example-label { color: var(--faded); }

  .sc-num {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.45rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--faded);
    margin-bottom: 1.2rem;
    transition: color 0.4s;
  }

  .sc-name {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }

  .sc-question {
    font-family: 'EB Garamond', serif;
    font-size: 1rem;
    font-style: italic;
    color: var(--faded);
    margin-bottom: 1rem;
    transition: color 0.4s;
  }

  .sc-desc {
    font-family: 'EB Garamond', serif;
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--warm-gray);
    transition: color 0.4s;
  }

  .sc-example {
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--paper-dark);
    font-family: 'EB Garamond', serif;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--warm-gray);
    transition: all 0.4s;
  }

  .sc-example-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.4rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faded);
    margin-bottom: 0.5rem;
    display: block;
    transition: color 0.4s;
  }

  /* next link */
  .next-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 3rem;
    border-bottom: 1px solid var(--paper-dark);
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
    transition: padding-left 0.4s;
  }
  .next-page:hover { padding-left: 3.8rem; }
  .next-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.5rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--faded); margin-bottom: 0.4rem;
  }
  .next-title {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.3rem; font-weight: 700;
  }
  .next-arrow {
    font-family: 'EB Garamond', serif;
    font-size: 1.8rem;
    transition: transform 0.3s;
  }
  .next-page:hover .next-arrow { transform: translateX(6px); }

  @media (max-width: 900px) {
    .strategies { grid-template-columns: 1fr; }
    .strategy-card { border-right: none; border-bottom: 1px solid var(--paper-dark); }
  }

  @media (max-width: 768px) {
    .page-header { padding: 7rem 1.5rem 2rem; }
    .frontier-container { padding: 1.5rem; }
    .strategies .strategy-card { padding: 2rem 1.5rem; }
    .next-page { padding: 2rem 1.5rem; }
  }
</style>
</head>
<body>

<nav>
  <a href="/" class="nav-logo">Literary Science</a>
  <ul class="nav-links">
    <li><a href="/epistemology/">Methodology</a></li>
    <li><a href="/toolkit/">Toolkit</a></li>
    <li><a href="/studio/">Studio</a></li>
