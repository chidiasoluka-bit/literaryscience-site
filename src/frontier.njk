</footer>

<script>
  // Scroll reveals
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Frontier animation
  const frontier = document.getElementById('frontier');
  function show(id, prop) {
    var el = document.getElementById(id);
    if (!el) return;
    if (prop === 'class') { el.classList.add('visible'); el.classList.add('drawn'); }
    else { el.style.opacity = '1'; }
  }
  const frontierObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        // 1. Draw the frontier curve + fill
        setTimeout(() => {
          show('curve', 'class');
          show('zoneFill', 'class');
          show('frontierLabel', 'class');
        }, 300);

        // 2. Innovation label at apex
        setTimeout(() => {
          show('innovLabel', 'class');
          show('innovSub', 'class');
        }, 1400);

        // 3. Starting point (orange X)
        setTimeout(() => {
          show('startPoint');
        }, 2000);

        // 4. Survival arrow (horizontal right)
        setTimeout(() => {
          show('survArrow');
          show('survLabel', 'class');
          show('survSub', 'class');
          show('dotCyan');
        }, 2600);

        // 5. Reform arrow (vertical up)
        setTimeout(() => {
          show('refArrow');
          show('refLabel', 'class');
          show('refSub', 'class');
          show('dotGreen');
        }, 3200);

        // 6. Agitation arrow (diagonal)
        setTimeout(() => {
          show('agiArrow');
          show('agiLabel', 'class');
          show('agiSub', 'class');
          show('dotMagenta');
        }, 3800);

        frontierObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  frontierObs.observe(frontier);
</script>
</body>
</html>
