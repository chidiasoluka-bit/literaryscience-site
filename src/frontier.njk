<script>
  // Scroll reveals
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Frontier animation
  const frontier = document.getElementById('frontier');
  const frontierObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        // Draw curve
        setTimeout(() => {
          document.getElementById('curve').classList.add('drawn');
          document.getElementById('zoneFill').classList.add('visible');
          document.getElementById('frontierLabel').classList.add('visible');
        }, 300);

        // Survival
        setTimeout(() => {
          document.getElementById('survDot').classList.add('visible');
          document.getElementById('survRing').classList.add('visible');
          document.getElementById('survLabel').classList.add('visible');
          document.getElementById('survSub').classList.add('visible');
        }, 1200);

        // Path 1
        setTimeout(() => {
          document.getElementById('path1').style.opacity = '0.25';
        }, 1800);

        // Reform
        setTimeout(() => {
          document.getElementById('refDot').classList.add('visible');
          document.getElementById('refRing').classList.add('visible');
          document.getElementById('refLabel').classList.add('visible');
          document.getElementById('refSub').classList.add('visible');
        }, 2200);

        // Path 2
        setTimeout(() => {
          document.getElementById('path2').style.opacity = '0.25';
        }, 2800);

        // Agitation
        setTimeout(() => {
          document.getElementById('agiDot').classList.add('visible');
          document.getElementById('agiRing').classList.add('visible');
          document.getElementById('agiLabel').classList.add('visible');
          document.getElementById('agiSub').classList.add('visible');
          document.getElementById('agiArrow').classList.add('visible');
          document.getElementById('agiArrowHead').classList.add('visible');
          document.getElementById('beyondLabel').classList.add('visible');
        }, 3200);

        frontierObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  frontierObs.observe(frontier);
</script>
</body>
</html>
