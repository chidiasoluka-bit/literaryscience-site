<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NewComm &mdash; Literary Science</title>
<link rel="stylesheet" href="/css/style.css">
<style>
  /* ── METHODOLOGY STRIP ── */
  .methodology-strip {
    padding: 4.5rem 3rem;
    background: var(--ink);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .methodology-strip::before,
  .methodology-strip::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0; width: 25px;
    background: repeating-linear-gradient(to bottom,
      transparent 0px, transparent 3px,
      rgba(242,242,242,0.04) 3px, rgba(242,242,242,0.04) 4px);
  }
  .methodology-strip::before { left: 0; }
  .methodology-strip::after { right: 0; }

  .methodology-strip p {
    font-family: 'Libre Baskerville', serif;
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-style: italic;
    line-height: 1.65;
    color: var(--paper);
    max-width: 640px;
    margin: 0 auto;
  }

  .page-header {
    padding: 8rem 3rem 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1; letter-spacing: -0.02em;
    margin-bottom: 0.8rem;
  }
  .page-header .page-desc {
    font-family: 'EB Garamond', serif;
    font-size: 1.15rem; line-height: 1.75;
    color: var(--warm-gray); max-width: 560px;
  }

  /* narrative */
  .narrative {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 3rem 4rem;
    border-top: 1px solid var(--paper-dark);
  }

  .narrative p {
    font-family: 'EB Garamond', serif;
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--warm-gray);
  }

  .narrative p + p { text-indent: 1.5em; }

  .narrative p strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* stats bar */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 900px;
    margin: 0 auto;
    border-top: 1px solid var(--paper-dark);
    border-bottom: 1px solid var(--paper-dark);
  }

  .stat-cell {
    padding: 2.5rem 2rem;
    border-right: 1px solid var(--paper-dark);
    text-align: center;
  }

  .stat-cell:last-child { border-right: none; }

  .stat-num {
    font-family: 'Libre Baskerville', serif;
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
  }

  .stat-desc {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.45rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faded);
    margin-top: 0.4rem;
    line-height: 1.5;
  }

  /* case study */
  .case-study {
    display: grid;
    grid-template-columns: 320px 1fr;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 500px;
  }

  .case-left {
    background: var(--ink);
    color: var(--paper);
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .case-left::after {
    content: '';
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 20px;
    background: repeating-linear-gradient(to bottom,
      transparent 0px, transparent 4px,
      rgba(242,242,242,0.03) 4px, rgba(242,242,242,0.03) 5px);
  }

  .case-tag {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.45rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--faded);
  }

  .case-novel-title {
    font-family: 'Libre Baskerville', serif;
    font-size: 2rem; font-style: italic; font-weight: 400;
    line-height: 1.2; color: var(--paper);
    margin-top: auto;
  }

  .case-novel-author {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.5rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--faded); margin-top: 0.5rem;
  }

  .case-novel-system {
    font-family: 'EB Garamond', serif;
    font-size: 0.95rem; font-style: italic;
    color: var(--paper-dark); margin-top: 1rem;
    line-height: 1.6; max-width: 260px;
  }

  .case-right {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .case-right p {
    font-family: 'EB Garamond', serif;
    font-size: 1.02rem; line-height: 1.85;
    color: var(--warm-gray); margin-bottom: 1.2rem;
  }

  .case-right p strong { font-weight: 600; color: var(--ink); }

  .case-homage {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--paper-dark);
  }

  .case-homage-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.45rem;
    letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--faded); margin-bottom: 0.8rem;
  }

  .case-homage p { color: var(--ink) !important; }

  /* homage strip */
  .homage-strip {
    padding: 2.5rem 2rem;
    border-bottom: 1px solid var(--paper-dark);
    text-align: center;
    background: var(--paper-light);
  }

  .homage-strip p {
    font-family: 'EB Garamond', serif;
    font-size: 1.05rem; font-style: italic;
    line-height: 1.7; color: var(--warm-gray);
    max-width: 600px; margin: 0 auto;
  }

  .homage-strip .h-attr {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.42rem;
    font-style: normal; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--paper-dark);
    display: block; margin-top: 0.6rem;
  }

  /* visit link */
  .visit {
    padding: 3rem;
    text-align: center;
  }

  .visit a {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.6rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    text-decoration: none; color: var(--ink);
    padding: 0.8rem 2rem;
    border: 1px solid var(--ink);
    transition: all 0.3s;
    display: inline-block;
  }

  .visit a:hover { background: var(--ink); color: var(--paper); }

  @media (max-width: 768px) {
    .stats-bar { grid-template-columns: 1fr; }
    .stat-cell { border-right: none; border-bottom: 1px solid var(--paper-dark); }
    .stat-cell:last-child { border-bottom: none; }
    .case-study { grid-template-columns: 1fr; }
    .case-left { min-height: 280px; }
    .narrative { padding: 2rem 1.5rem 3rem; }
  }
</style>
</head>
