---
layout: false
nav: toolkit
title: The Toolkit
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Toolkit — Literary Science</title>
<link rel="stylesheet" href="/css/style.css">
<style>
  .page-header {
    padding: 8rem 3rem 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1; letter-spacing: -0.02em;
    margin-bottom: 0.8rem;
  }
  .page-header .page-desc {
    font-family: 'EB Garamond', serif;
    font-size: 1.15rem; line-height: 1.75;
    color: var(--warm-gray); max-width: 500px;
  }

  .tools {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 3rem 5rem;
    border-top: 1px solid var(--paper-dark);
  }

  .tool {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: start;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--paper-dark);
    transition: padding-left 0.3s;
  }
  .tool:hover { padding-left: 1rem; }

  .tool-type {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.42rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--faded); margin-bottom: 0.5rem;
  }
  .tool-title {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700; font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }
  .tool-desc {
    font-family: 'EB Garamond', serif;
    font-size: 0.95rem; line-height: 1.7;
    color: var(--warm-gray); max-width: 520px;
  }
  .tool-dl {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.52rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    text-decoration: none; color: var(--ink);
    border: 1px solid var(--paper-dark);
    padding: 0.6rem 1.2rem;
    transition: all 0.3s; white-space: nowrap;
    display: inline-block; margin-top: 0.5rem;
  }
  .tool-dl:hover {
    background: var(--ink); color: var(--paper);
    border-color: var(--ink);
  }
  .tool-dl.coming {
    color: var(--paper-dark); border-color: var(--paper-dark); cursor: default;
  }
  .tool-dl.coming:hover {
    background: transparent; color: var(--paper-dark); border-color: var(--paper-dark);
  }

  .tools-cta {
    padding: 3rem 3rem 5rem;
    max-width: 900px; margin: 0 auto;
  }
  .tools-cta p {
    font-family: 'EB Garamond', serif;
    font-size: 1.1rem; line-height: 1.75;
    color: var(--warm-gray); max-width: 500px;
  }
  .tools-cta a {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.55rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    text-decoration: none; color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 3px; margin-top: 1rem;
    display: inline-block; transition: padding-bottom 0.3s;
  }
  .tools-cta a:hover { padding-bottom: 6px; }

  /* ── ASSET VOCABULARY ── */
  .asset-vocab {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 3rem 4rem;
  }
  .vocab-header {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    padding: 3rem 0 2rem;
    border-bottom: 2px solid var(--ink);
  }
  .vocab-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.45rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--faded);
    padding-top: 0.4rem;
    line-height: 1.8;
  }
  .vocab-title {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }
  .vocab-desc {
    font-family: 'EB Garamond', serif;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--warm-gray);
    max-width: 520px;
  }
  .vocab-row {
    display: grid;
    grid-template-columns: 50px 180px 1fr;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--paper-dark);
    align-items: baseline;
    transition: all 0.4s;
  }
  .vocab-row:hover {
    background: var(--ink);
    color: var(--paper);
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  .vocab-num {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300;
    font-size: 0.5rem;
    letter-spacing: 0.15em;
    color: var(--faded);
    transition: color 0.4s;
  }
  .vocab-row:hover .vocab-num { color: rgba(242,242,242,0.5); }
  .vocab-name {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700;
    font-size: 1rem;
  }
  .vocab-def {
    font-family: 'EB Garamond', serif;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--warm-gray);
    transition: color 0.4s;
  }
  .vocab-row:hover .vocab-def { color: rgba(242,242,242,0.6); }

  @media (max-width: 768px) {
    .vocab-header { grid-template-columns: 1fr; gap: 1rem; }
    .vocab-row { grid-template-columns: 40px 1fr; gap: 0.8rem; }
    .vocab-def { grid-column: 1 / -1; }
  }

  @media (max-width: 600px) {
    .tool { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
</head>
<body>

<nav>
  <a href="/" class="nav-logo">Literary Science</a>
  <ul class="nav-links">
    <li><a href="/epistemology/">Methodology</a></li>
    <li><a href="/toolkit/" class="active">Toolkit</a></li>
    <li><a href="/studio/">Studio</a></li>
    <li><a href="/newcomm/">NewComm</a></li>
    <li><a href="/workshops/">Workshops</a></li>
    <li><a href="/about/">About</a></li>
  </ul>
</nav>

<header class="page-header">
  <div class="section-label">The Toolkit</div>
  <h1>Toolkit</h1>
  <p class="page-desc">The open shelf by the door. Free tools for teachers, facilitators, and practitioners. Download Friday, use Monday.</p>
</header>

<!-- ── ASSET VOCABULARY ── -->
<div class="asset-vocab">
  <div class="vocab-header reveal">
    <div class="vocab-label">The Vocabulary<br>LS&ndash;001</div>
    <div>
      <h2 class="vocab-title">Asset Stocks</h2>
      <p class="vocab-desc">Literary Science reads novels the way it reads communities&mdash;by identifying what circulates, what is blocked, and what is carried forward. These are the categories of capital the methodology tracks.</p>
    </div>
  </div>

  <div class="vocab-row reveal">
    <div class="vocab-num">01</div>
    <div class="vocab-name">Human Capital</div>
    <div class="vocab-def">Skills, knowledge, and expertise held by individuals&mdash;the parent who teaches, the coach who disciplines, the student who translates.</div>
  </div>
  <div class="vocab-row reveal">
    <div class="vocab-num">02</div>
    <div class="vocab-name">Social Capital</div>
    <div class="vocab-def">Networks, relationships, and trust&mdash;the neighbors who show up, the elders who counsel, the circles that hold.</div>
  </div>
  <div class="vocab-row reveal">
    <div class="vocab-num">03</div>
    <div class="vocab-name">Natural Resources</div>
    <div class="vocab-def">Environmental gifts&mdash;clean water, green space, community gardens, the creek that still runs.</div>
  </div>
  <div class="vocab-row reveal">
    <div class="vocab-num">04</div>
    <div class="vocab-name">Built Infrastructure</div>
    <div class="vocab-def">Libraries, cultural centers, transit routes, safe streets&mdash;the physical architecture of access.</div>
  </div>
  <div class="vocab-row reveal">
    <div class="vocab-num">05</div>
    <div class="vocab-name">Financial Capital</div>
    <div class="vocab-def">Grants, microloans, scholarships&mdash;the money that moves, and the money that doesn&rsquo;t.</div>
  </div>
  <div class="vocab-row reveal">
    <div class="vocab-num">06</div>
    <div class="vocab-name">Manufactured Capital</div>
    <div class="vocab-def">Tools, computers, instruments, shared machines&mdash;the physical means of production held in common.</div>
  </div>
  <div class="vocab-row reveal">
    <div class="vocab-num">07</div>
    <div class="vocab-name">Public Knowledge</div>
    <div class="vocab-def">Oral histories, open-source materials, cultural health practices&mdash;wisdom that belongs to everyone and no one.</div>
  </div>
</div>

<div class="tools">
  {% for tool in collections.toolkit %}
  <div class="tool reveal">
    <div>
      <div class="tool-type">{{ tool.data.format }} — {{ tool.data.filetype or 'PDF' }}</div>
      <div class="tool-title">{{ tool.data.title }}</div>
      <p class="tool-desc">{{ tool.templateContent | safe }}</p>
    </div>
    {% if tool.data.download_url %}
    <a href="#" class="tool-dl" data-download="{{ tool.data.download_url }}" data-tool="{{ tool.data.title }}" onclick="openGate(this); return false;">Download</a>
    {% else %}
    <span class="tool-dl coming">Coming soon</span>
    {% endif %}
  </div>
  {% endfor %}
</div>

<!-- Hidden Netlify form for bot detection -->
<form name="toolkit-signup" netlify netlify-honeypot="bot-field" hidden>
  <input name="bot-field">
  <input name="name">
  <input name="email">
  <input name="source" value="toolkit">
</form>

<div class="signup-strip dark reveal" style="max-width: 900px; margin: 0 auto; border-top: 2px solid var(--ink);">
  <div class="signup-inner" style="grid-template-columns: 1fr; max-width: 600px;">
    <div class="signup-content">
      <div class="signup-label" style="margin-bottom: 1rem;">Lead Resource<br>Free Download</div>
      <h2>Get the free Four Movements One-Pager.</h2>
      <p>A single page: the four movements, their guiding questions, and what each looks like in the novel vs. the community. Print it. Pin it to your wall. Use it Monday.</p>
      <form class="signup-form" id="toolkitSignup" onsubmit="submitSignup(event, 'toolkit-signup', this)">
        <input type="hidden" name="form-name" value="toolkit-signup">
        <input type="hidden" name="bot-field">
        <input type="hidden" name="source" value="toolkit">
        <div class="signup-field">
          <label for="tk-name">Name</label>
          <input type="text" id="tk-name" name="name" placeholder="Your name" required class="signup-input">
        </div>
        <div class="signup-field">
          <label for="tk-email">Email</label>
          <input type="email" id="tk-email" name="email" placeholder="Email address" required class="signup-input">
        </div>
        <button type="submit" class="signup-btn">Get the one-pager &rarr;</button>
      </form>
      <div class="signup-success" id="toolkitSuccess">You&rsquo;re in. We&rsquo;ll send the one-pager to your inbox.</div>
    </div>
  </div>
</div>

<div class="tools-cta reveal">
  <p>These tools are free and always will be. If you want to go deeper&mdash;workshops, certification, or institutional design consulting&mdash;reach out.</p>
  <a href="/workshops/">Get in touch &rarr;</a>
</div>

<footer>
  <div class="footer-left">Literary Science</div>
  <div class="footer-right">A <a href="https://www.newcommpartners.org" style="color: var(--faded);">NewComm Partners</a> property &nbsp;—&nbsp; <a href="mailto:hello@literaryscience.com">Contact</a> &nbsp;—&nbsp; © 2026</div>
</footer>

<!-- Hidden Netlify form for bot detection -->
<form name="toolkit-downloads" netlify netlify-honeypot="bot-field" hidden>
  <input name="bot-field">
  <input name="name">
  <input name="email">
  <input name="profession">
  <input name="tool">
</form>

<!-- Email Gate Modal -->
<div class="gate-overlay" id="gateOverlay" onclick="if(event.target===this)closeGate()">
  <div class="gate-modal">
    <button class="gate-close" onclick="closeGate()">&times;</button>
    <div class="gate-label">Free Download</div>
    <h2 class="gate-title" id="gateTitle">Tool Name</h2>
    <p class="gate-desc">Enter your email to receive the download. We'll occasionally share new tools and updates — nothing else.</p>
    <form id="gateForm" onsubmit="submitGate(event)">
      <input type="text" name="name" id="gateName" placeholder="Your name" required class="gate-input">
      <input type="email" name="email" id="gateEmail" placeholder="Email address" required class="gate-input">
      <input type="text" name="profession" id="gateProfession" placeholder="Your profession (e.g. Teacher, Counselor, Administrator)" required class="gate-input">
      <input type="hidden" name="tool" id="gateTool">
      <input type="hidden" name="form-name" value="toolkit-downloads">
      <input type="hidden" name="bot-field">
      <button type="submit" class="gate-submit" id="gateSubmit">Get the download</button>
    </form>
    <div class="gate-success" id="gateSuccess" style="display:none;">
      <p>You're in. Your download is ready.</p>
      <a href="#" class="gate-download-btn" id="gateDownloadLink" download>Download now →</a>
    </div>
  </div>
</div>

<style>
  .gate-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(17,17,17,0.7); z-index: 10000;
    display: none; align-items: center; justify-content: center;
    backdrop-filter: blur(3px);
  }
  .gate-overlay.active { display: flex; }

  .gate-modal {
    background: var(--paper); padding: 3rem;
    max-width: 420px; width: 90%; position: relative;
    border: 1px solid var(--paper-dark);
  }
  .gate-close {
    position: absolute; top: 1rem; right: 1.2rem;
    background: none; border: none; font-size: 1.5rem;
    cursor: pointer; color: var(--faded); line-height: 1;
    transition: color 0.3s;
  }
  .gate-close:hover { color: var(--ink); }

  .gate-label {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.45rem;
    letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--faded); margin-bottom: 0.8rem;
  }
  .gate-title {
    font-family: 'Libre Baskerville', serif;
    font-weight: 700; font-size: 1.3rem;
    margin-bottom: 0.8rem; line-height: 1.3;
  }
  .gate-desc {
    font-family: 'EB Garamond', serif;
    font-size: 0.95rem; line-height: 1.7;
    color: var(--warm-gray); margin-bottom: 1.8rem;
  }
  .gate-input {
    display: block; width: 100%;
    font-family: 'EB Garamond', serif;
    font-size: 1rem; padding: 0.75rem 0;
    border: none; border-bottom: 1px solid var(--paper-dark);
    background: transparent; color: var(--ink);
    outline: none; margin-bottom: 1rem;
    transition: border-color 0.3s;
  }
  .gate-input:focus { border-color: var(--ink); }
  .gate-input::placeholder { color: var(--faded); }

  .gate-submit {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.55rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    background: var(--ink); color: var(--paper);
    border: 1px solid var(--ink); padding: 0.8rem 1.5rem;
    cursor: pointer; margin-top: 0.5rem;
    transition: all 0.3s; width: 100%;
  }
  .gate-submit:hover { background: transparent; color: var(--ink); }
  .gate-submit:disabled { opacity: 0.5; cursor: wait; }

  .gate-success { text-align: center; padding-top: 1rem; }
  .gate-success p {
    font-family: 'EB Garamond', serif;
    font-size: 1.1rem; color: var(--ink);
    margin-bottom: 1.2rem;
  }
  .gate-download-btn {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 300; font-size: 0.55rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    text-decoration: none; color: var(--ink);
    border: 1px solid var(--ink); padding: 0.8rem 1.5rem;
    display: inline-block; transition: all 0.3s;
  }
  .gate-download-btn:hover { background: var(--ink); color: var(--paper); }
</style>

<script>
  let currentDownloadUrl = '';

  function openGate(el) {
    currentDownloadUrl = el.getAttribute('data-download');
    const toolName = el.getAttribute('data-tool');
    document.getElementById('gateTitle').textContent = toolName;
    document.getElementById('gateTool').value = toolName;
    document.getElementById('gateForm').style.display = 'block';
    document.getElementById('gateSuccess').style.display = 'none';
    document.getElementById('gateName').value = '';
    document.getElementById('gateEmail').value = '';
    document.getElementById('gateProfession').value = '';
    document.getElementById('gateOverlay').classList.add('active');
  }

  function closeGate() {
    document.getElementById('gateOverlay').classList.remove('active');
  }

  async function submitGate(e) {
    e.preventDefault();
    const btn = document.getElementById('gateSubmit');
    btn.disabled = true;
    btn.textContent = 'Submitting...';

    const form = e.target;
    const data = new URLSearchParams(new FormData(form));

    try {
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data.toString()
      });
    } catch (err) {
      // Still show download even if form submission fails
    }

    document.getElementById('gateForm').style.display = 'none';
    document.getElementById('gateDownloadLink').href = currentDownloadUrl;
    document.getElementById('gateSuccess').style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Get the download';
  }
</script>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  async function submitSignup(e, formName, formEl) {
    e.preventDefault();
    const btn = formEl.querySelector('.signup-btn');
    const origText = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Submitting...';

    const data = new URLSearchParams(new FormData(formEl));

    try {
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data.toString()
      });
    } catch (err) {}

    formEl.style.display = 'none';
    const successEl = formEl.parentElement.querySelector('.signup-success');
    if (successEl) successEl.style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = origText;
  }
</script>
</body>
</html>
